generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  MN
  EN
}

enum Color {
  WHITE
  BLACK
}

enum GameSource {
  MANUAL
  PGN_IMPORT
  LICHESS
  CHESSCOM
  OCR
}

enum MoveClassification {
  BOOK
  BEST
  EXCELLENT
  GOOD
  INACCURACY
  MISTAKE
  BLUNDER
}

enum PuzzleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String?
  preferredLanguage  Language                 @default(MN)
  ratingEstimate     Int                      @default(800)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  refreshSessions    RefreshSession[]
  games              Game[]
  progressSnapshots  ProgressSnapshot[]
  puzzleAttempts     PuzzleAttempt[]
  recommendations    TrainingRecommendation[]
}

model RefreshSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id              String      @id @default(cuid())
  userId          String?
  pgn             String      @db.Text
  initialFen      String?
  finalFen        String?
  result          String?
  openingEco      String?
  openingName     String?
  source          GameSource  @default(MANUAL)
  accuracyWhite   Float?
  accuracyBlack   Float?
  criticalMistakes Int        @default(0)
  tags            String[]    @default([])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  moves           Move[]
  analyses        Analysis[]

  @@index([userId, createdAt])
}

model Move {
  id              String              @id @default(cuid())
  gameId          String
  ply             Int
  moveNumber      Int
  color           Color
  san             String
  uci             String?
  fenBefore       String              @db.Text
  fenAfter        String              @db.Text
  classification  MoveClassification?
  centipawnLoss   Int?
  bestMove        String?
  createdAt       DateTime            @default(now())
  game            Game                @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysis        Analysis?
  mistake         Mistake?

  @@unique([gameId, ply])
  @@index([gameId, moveNumber])
}

model Analysis {
  id                 String   @id @default(cuid())
  gameId             String?
  moveId             String?  @unique
  depth              Int
  scoreCpWhite       Int?
  mateIn             Int?
  bestMove           String?
  principalVariation String[] @default([])
  raw                Json?
  createdAt          DateTime @default(now())
  game               Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  move               Move?    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Mistake {
  id              String             @id @default(cuid())
  moveId          String             @unique
  userId          String?
  classification  MoveClassification
  reason          String?
  tags            String[]           @default([])
  resolvedAt      DateTime?
  createdAt       DateTime           @default(now())
  move            Move               @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ProgressSnapshot {
  id               String   @id @default(cuid())
  userId           String
  gamesReviewed    Int      @default(0)
  averageAccuracy  Float    @default(0)
  blundersPerGame  Float    @default(0)
  tacticalScore    Float    @default(0)
  strategicScore   Float    @default(0)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Puzzle {
  id          String         @id @default(cuid())
  fen         String         @db.Text
  solution    String[]
  themes      String[]       @default([])
  difficulty  Int            @default(800)
  status      PuzzleStatus   @default(DRAFT)
  createdAt   DateTime       @default(now())
  attempts    PuzzleAttempt[]
}

model PuzzleAttempt {
  id          String   @id @default(cuid())
  userId      String
  puzzleId    String
  solved      Boolean  @default(false)
  timeMs      Int?
  mistakes    Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle      Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TrainingRecommendation {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  tags        String[] @default([])
  priority    Int      @default(1)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}
