{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@mda-chess/api-client": ["packages/api-client/src/index.ts"],
      "@mda-chess/chess-engine": ["packages/chess-engine/src/index.ts"],
      "@mda-chess/shared": ["packages/shared/src/index.ts"],
      "@mda-chess/ui": ["packages/ui/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true
  }
}
